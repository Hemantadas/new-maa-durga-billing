rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Every shop's data is isolated by the UID issued by Firebase Authentication.
    // A Shop ID entered in the app is never trusted as an authorization boundary.
    match /shops/{shopUid}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == shopUid;
    }

    // Authentication index and all other top-level documents are server-only.
    // Admin SDK operations from Cloud Functions bypass these client rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
